	"与法拉叶的第一次交流":{
		"0th":{
			"name":"",
			"text":"这是一个还没有被磨平棱角的犯人，眼神里还有一股狠劲，像一匹没有被驯化的狼。",
			"next":1,
		},
		"1th":{
			"name":"{player_name}",
			"text":"你叫什么名字，我对你感兴趣。",
			"is_option": false,
			"next": 2,
		},
		"2th":{
			"name":"？？？",
			"text":"法拉叶，你的兴趣有什么用？",
			"is_option": false,
			"next": 3,
		},
		"3th":{
			"name":"player_name",
			"text":"可以让你自由。说说吧，犯了什么事。",
			"is_option": false,
			"next": 4,
		},
		"4th":{
			"name":"法拉叶",
			"text":"何必消遣我。（忽然咧开嘴笑起来）老实说我不知道，只听说是什么聚众，什么斗殴。事实上，我仅仅只是路过。",
			"is_option": false,
			"next": 5,
		},
		"5th":{
			"name":"",
			"text":"他说是被冤枉的，你知道这个国家的警察的靠谱程度和贿赂成正比，可是他们到底不会多管闲事。",
			"is_option": false,
			"next": 6,
		},
		"6th":{
			"name":"法拉叶",
			"text":"先生，如果你对我尚存一丝怜悯，可以让我吃点好的吗，我已经一个月没有见过荤了。",
			"is_option": false,
			"effect":{
				"tags":["认识法拉叶"],
			},
			"next": -1,
		},
	},
	
	
